---
import Layout from "../layouts/Layout.astro";

type Tool = {
    id: string;
    name: string;
    image?: string;
}
const tools = [
    {
        id: "runsheet",
        name: "Run Sheet"
    }
] as Array<Tool>;
---

<Layout>
    <section class="tools-container">
        {tools.map(tool => (
            <a href={`/${tool.id}`}>
                <h3>{tool.name}</h3>
                {tool.image? <img src={tool.image} /> : null}
            </a>))}
    </section>
</Layout>
<style>
    .tools-container {
        width: var(--full);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2px;
        font-size: 12px;
        margin: 2px;
        background-image: linear-gradient(to bottom, var(--spring-green), darkolivegreen);
    }
</style>