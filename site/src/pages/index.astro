---
import HeroSection from "../components/HeroSection.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Layout from "../layouts/Layout.astro";
import { projectsConfig } from "../lib/constants";
---

<Layout>
  <HeroSection />
  <section class="main-section">
    <h2>Projects</h2>
    <div class="projects-container">
      {projectsConfig.map(project => (<ProjectCard project={project} />))}
    </div>
  </section>
</Layout>
<style>
  .main-section {
    width: var(--full);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2px;
    font-size: 16px;
    font-weight: 700;
    color: var(--lavender);
  }
  .projects-container {
    display: flex;
    flex: wrap;
    gap: 2px;
    align-items: center;
    justify-content: center;
  }
</style>

